PORT=8080
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/groopx?sslmode=disable
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REDIS_URL=redis://localhost:6379/0
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=groopx-media
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_PUBLIC_BASE_URL=https://media.example.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
